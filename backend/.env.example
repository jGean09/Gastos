# Porta do servidor (o Render define isso automaticamente)
PORT=3000

# Cole aqui o conteúdo COMPLETO do seu arquivo de credenciais do Firebase (JSON em uma linha)
# Exemplo: {"type": "service_account", "project_id": "...", ...}
FIREBASE_CREDENTIALS_JSON=

# Origens permitidas pelo CORS (separadas por vírgula, sem espaços)
# Exemplo no Render: https://meu-frontend.vercel.app,https://meu-dominio.com
# Em desenvolvimento: http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=
