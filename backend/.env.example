# Servidor Express
PORT=3000
NODE_ENV=development

# Segurança e CORS (Separe múltiplas origens por vírgula)
CORS_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://gastos-casal-26c77.web.app

# Autenticação e Sessões (JWT)
JWT_SECRET=sua_chave_secreta_jwt_longa_e_aleatoria_aqui
JWT_EXPIRATION=30m
REFRESH_TOKEN_EXPIRATION=7d

# Criptografia de Dados em Repouso (AES-256-GCM)
# Opcional: Se omitido, deriva de forma segura a partir do JWT_SECRET. Para chave dedicada, use 64 hex chars (32 bytes).
ENCRYPTION_KEY=

# Credenciais do Firebase Admin (JSON em linha única ou caminho do arquivo)
# Em produção no Render/Cloud, passe o conteúdo JSON completo do service account
FIREBASE_CREDENTIALS_JSON=

# Monitoramento de Erros (Opcional - Sentry / Logtail)
SENTRY_DSN=
LOG_LEVEL=info
